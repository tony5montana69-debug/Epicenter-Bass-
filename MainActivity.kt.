
package com.epicenter.bass

import android.app.Activity
import android.os.Bundle
import android.content.Intent
import android.net.Uri
import android.graphics.Color
import android.view.Gravity
import android.widget.LinearLayout
import android.widget.TextView
import android.widget.SeekBar
import android.widget.Button

class MainActivity : Activity() {

    private val musicPlayer = MusicPlayer()
    private var selectedSong: Uri? = null
    private val blue = Color.rgb(0, 180, 255)

    private val picker = registerForActivityResult(
        androidx.activity.result.contract.ActivityResultContracts.OpenDocument()
    ) { uri ->
        if (uri != null) {
            selectedSong = uri
            contentText.text = "CANCIÓN SELECCIONADA"
        }
    }

    private lateinit var contentText: TextView

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        window.statusBarColor = Color.BLACK
        window.navigationBarColor = Color.BLACK

        val layout = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            gravity = Gravity.CENTER
            setPadding(25, 25, 25, 25)
            setBackgroundColor(Color.rgb(5, 7, 15))
        }

        fun addText(text: String, size: Float) {
            layout.addView(TextView(this).apply {
                this.text = text
                textSize = size
                gravity = Gravity.CENTER
                setTextColor(blue)
                setPadding(5, 12, 5, 12)
            })
        }

        fun addButton(text: String, action: () -> Unit) {
            layout.addView(Button(this).apply {
                this.text = text
                setOnClickListener { action() }
            })
        }

        addText("EPICENTER-BASS", 30f)
        addText("POTENCIA TU MÚSICA", 18f)

        contentText = TextView(this).apply {
            text = "NINGUNA CANCIÓN SELECCIONADA"
            setTextColor(Color.WHITE)
            gravity = Gravity.CENTER
        }
        layout.addView(contentText)

        addButton("SELECCIONAR CANCIÓN") {
            picker.launch(arrayOf("audio/*"))
        }

        addButton("▶ REPRODUCIR") {
            selectedSong?.let {
                musicPlayer.play(this, it)
            }
        }

        addButton("⏸ PAUSAR") {
            musicPlayer.pause()
        }

        addButton("■ DETENER") {
            musicPlayer.stop()
        }

        addText("POTENCIADOR DE BAJOS", 18f)

        val bass = SeekBar(this).apply {
            max = 100
            progress = 50
        }

        bass.setOnSeekBarChangeListener(
            object : SeekBar.OnSeekBarChangeListener {
                override fun onProgressChanged(
                    seekBar: SeekBar?, value: Int, fromUser: Boolean
                ) {
                    musicPlayer.setBass(value)
                }
                override fun onStartTrackingTouch(seekBar: SeekBar?) {}
                override fun onStopTrackingTouch(seekBar: SeekBar?) {}
            }
        )

        layout.addView(bass)

        setContentView(layout)
    }

    override fun onDestroy() {
        musicPlayer.stop()
        super.onDestroy()
    }
}
